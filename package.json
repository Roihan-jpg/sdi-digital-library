{
  "name": "sdi-digital-library",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm --prefix frontend start",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "npm --prefix backend run lint",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:backend",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "npm --prefix frontend test -- --watch=false",
    "test:backend": "npm --prefix backend test",
    "db:start": "npx supabase start",
    "db:reset": "npx supabase db reset",
    "db:test": "node scripts/run-db-tests.mjs",
    "db:push": "npx supabase db push",
    "db:types": "npx supabase gen types typescript --local > backend/src/generated/database.types.ts",
    "maintenance": "npm --prefix backend run maintenance",
    "smoke:uat": "node scripts/smoke-uat.mjs"
  },
  "version": "1.0.0",
  "description": "Paket ini berisi rancangan implementasi website digital library untuk perpustakaan sekolah dasar.",
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.3",
    "supabase": "^2.109.1"
  }
}
